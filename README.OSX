# Instructions  
Guide from https://www.deusinmachina.net/p/lets-compile-linux-doom  
#  Install brew install --cask xquartz  
Ensure xquartz is running 

Check display used
xdpyinfo | grep 'depth of root window'

# Run XDisplay   
In a seperate terminal run  
sudo Xephyr :2 -ac -screen 640x480x8 
// download a wad from   
https://www.doomworld.com/classicdoom/info/shareware.php  
Place the wad into the rood directory of the binary.

# Compile  
cd linuxdoom-1.10

// do only once
mkdir linux 

// Compile source
make -j

// this will compile the binary into a folder called "linux"
// copy the doom.wad into this directory or just combine the binary and the .wad in a seperate folder.

# Run  
// then run the following to start the game. ensure the .wad is located in the same directory as the binary. 
Also run the command from inside the same directory as the binary and wad to fix any working directory issues.
DISPLAY=:2 ./linuxxdoom -file doom.wad

